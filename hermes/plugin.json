  "author": {
    "name": "WebTwizz",
    "email": "support@webtwizz.com",
    "url": "https://webtwizz.com"
  },
  "homepage": "https://webtwizz.com/mcp",
  "repository": "https://github.com/WebTwizz/agent",
  "license": "MIT",
  "keywords": [
    "webtwizz",
    "website-builder",
    "app-builder",
    "websites",
    "web-apps",
    "landing-pages",
    "publishing",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "webtwizz": {
          "trust": "untrusted"
        }
      }
    }
  }
}
